# Env variables to customise the recipe.

# Name for the docker swarm stack configured via docker-compose.yml
STACK_NAME="mongo"

# Name of the docker swarm service which has MongoDB containers that should be a replicaset
MONGO_SERVICE_NAME=${STACK_NAME}_mongo

# The version of MongoDB that the `${MONGO_SERVICE_NAME}` service should launch
MONGO_VERSION=8.2

# Name / ID for the replicaset that the MongoDB replicas should be members of
REPLICASET_NAME="rs"

# Name of the docker network that the MongoDB replicas *and* the mongo_controller container should communicate on
BACKEND_NETWORK_NAME="backend"

# How often the health of the mongo cluster should be checked for when its status is "starting"
START_INTERVAL_SECONDS=5

# Maximum duration of the "starting" period before regular healthchecks should be attempted.
START_PERIOD_SECONDS=60

# Duration of the interval between healthchecks when the service status is "running"
HEALTHCHECK_INTERVAL=$((CONTROL_INTERVAL_SECONDS * 3))

# Maximum amount of time a healthcheck may take before being automatically failed.
HEALTHCHECK_TIMEOUT=10

# How long a mongo container is expected to take to shut down cleanly
SHUTDOWN_PERIOD_SECONDS=10

# How long to delay after a mongo container fails its healthcheck before spawning a replacement.
RESTART_DELAY=$((SHUTDOWN_PERIOD_SECONDS * 2))

# Name of the docker service which controls the MongoDB replicaset
CONTROLLER_SERVICE_NAME="${STACK_NAME}_controller"

# The tag that should be used for the locally-build `${CONTROLLER_SERVICE}` image
# (if you use 'latest', docker will attempt to pull it from the registry on launch instead)
CONTROLLER_TAG="dev"

# Duration of the interval between control attempts made by the mongo_controller
CONTROL_INTERVAL_SECONDS=20
